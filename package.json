{
  "name": "rescayl",
  "private": true,
  "version": "2.16.0-preview.4",
  "productName": "Rescayl",
  "author": {
    "name": "forsonny",
    "url": "https://github.com/forsonny"
  },
  "homepage": "https://github.com/forsonny/Rescayl",
  "contributors": [
    {
      "name": "Nayam Amarshe",
      "email": "nayam.emikx@aleeas.com",
      "url": "https://github.com/NayamAmarshe"
    },
    {
      "name": "TGS963",
      "email": "tgs@963.com",
      "url": "https://github.com/TGS963"
    }
  ],
  "license": "AGPL-3.0",
  "description": "Rescayl — image upscaling for personal photos, artwork, and everyday images",
  "keywords": [
    "image upscaling",
    "photos",
    "artwork",
    "AI",
    "desktop",
    "Windows",
    "Linux"
  ],
  "main": "export/electron/index.js",
  "scripts": {
    "clean": "rimraf dist renderer/.next renderer/out",
    "start": "npm run tsc && electron .",
    "dev": "npm run tsc && electron .",
    "build": "npm run tsc && npm run validate-schema && next build renderer --webpack",
    "tsc": "tsc && npm run build-preload",
    "pack-app": "npm run tsc && npm run build && electron-builder --dir",
    "dist": "npm run tsc && npm run build && cross-env DEBUG=* electron-builder",
    "dist:appimage": "npm run tsc && npm run build && cross-env DEBUG=* electron-builder build -l AppImage",
    "dist:flatpak": "npm run tsc && npm run build && cross-env DEBUG=* electron-builder build -l flatpak",
    "dist:deb": "npm run tsc && npm run build && cross-env DEBUG=* electron-builder build -l deb",
    "dist:rpm": "npm run tsc && npm run build && cross-env DEBUG=* electron-builder build -l rpm",
    "dist:zip": "npm run tsc && npm run build && cross-env DEBUG=* electron-builder build -l zip",
    "dist:mac-zip": "npm run tsc && npm run build && electron-builder build -m --universal",
    "dist:dmg": "npm run tsc && npm run build && electron-builder build -m dmg",
    "dist:msi": "npm run tsc && npm run build && cross-env DEBUG=* electron-builder build -w nsis",
    "dist:pkg": "npm run tsc && npm run build && cross-env DEBUG=* electron-builder build -m pkg",
    "dist:mac": "npm run tsc && npm run build && electron-builder --mac --universal",
    "dist:mac-dev": "npm run tsc && npm run build && electron-builder --mac --arm64 -c mac-dev.json",
    "dist:mac-arm64": "npm run tsc && npm run build && electron-builder --mac --arm64",
    "dist:mas": "npm run enable-store && npm run tsc && npm run build && electron-builder --mac mas --universal -c mas.json && npm run disable-store",
    "dist:mas-dev": "npm run enable-store && npm run tsc && npm run build && electron-builder --mac mas-dev --universal -c mas-dev.json && npm run disable-store",
    "dist:win": "npm run tsc && npm run build && electron-builder --win",
    "dist:linux": "npm run tsc && npm run build && electron-builder --linux",
    "publish-app": "npm run tsc && npm run build && electron-builder -wlm --publish always",
    "publish-linux-app": "npm run tsc && npm run build && electron-builder -l --publish always",
    "publish-win-app": "npm run tsc && npm run build && electron-builder -w --publish always",
    "publish-mac-universal-app": "npm run tsc && npm run build && electron-builder --mac --universal --publish always",
    "publish-mac-app": "npm run tsc && npm run build && electron-builder --mac --x64 --publish always",
    "publish-mac-arm-app": "npm run tsc && npm run build && electron-builder --mac --arm64 --publish always",
    "dist:appstore": "CSC_KEY_PASSWORD=$PASSWORD CSC_LINK=$(openssl base64 -in $CERTIFICATE_PATH) npm run dist:mac-mas",
    "enable-store": "sed -i '' -e 's/APP_STORE_BUILD: false,/APP_STORE_BUILD: true,/' common/feature-flags.ts",
    "disable-store": "sed -i '' -e 's/APP_STORE_BUILD: true,/APP_STORE_BUILD: false,/' common/feature-flags.ts",
    "validate-schema": "node scripts/validate-schema.js",
    "build-preload": "esbuild electron/preload.ts --bundle --platform=node --target=node24 --external:electron --outfile=export/electron/preload.js",
    "test:security": "npm run tsc && node --test scripts/security.test.cjs",
    "test": "npm run test:security",
    "verify-native": "node scripts/verify-native.cjs",
    "update-native": "node scripts/update-native.cjs",
    "dist:win:signed": "npm run build && electron-builder --win --x64 --publish never -c.forceCodeSigning=true"
  },
  "build": {
    "productName": "Rescayl",
    "appId": "io.github.forsonny.rescayl",
    "artifactName": "${name}-${version}-${os}.${ext}",
    "afterSign": "./notarize.js",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*"
    ],
    "extraFiles": [
      {
        "from": "resources/${os}/bin",
        "to": "resources/bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/models",
        "to": "resources/models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icons/128x128.png",
        "to": "resources/128x128.png"
      },
      {
        "from": "resources/icons/512x512.png",
        "to": "resources/512x512.png"
      }
    ],
    "mas": {
      "hardenedRuntime": false,
      "electronLanguages": [
        "en"
      ],
      "category": "public.app-category.photography",
      "entitlements": "resources/entitlements.mas.plist",
      "entitlementsInherit": "resources/entitlements.mas.inherit.plist",
      "provisioningProfile": "embedded.provisionprofile",
      "mergeASARs": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns",
      "x64ArchFiles": "*",
      "target": [
        {
          "target": "mas",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "mergeASARs": false,
      "x64ArchFiles": "*",
      "minimumSystemVersion": "13.0.0",
      "category": "public.app-category.photography",
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "provisioningProfile": "embedded.provisionprofile",
      "type": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "sign": "false",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "zip",
        "deb",
        "rpm"
      ],
      "maintainer": "forsonny",
      "category": "Graphics;2DGraphics;RasterGraphics;ImageProcessing;",
      "synopsis": "Rescayl Image Upscaler",
      "description": "Image upscaling for personal photos, artwork, and everyday images",
      "icon": "resources/icons/"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "allowElevation": true,
      "perMachine": false
    },
    "files": [
      "export",
      "renderer/out",
      "renderer/fonts/asap/OFL.txt",
      "renderer/fonts/lato/OFL.txt"
    ],
    "publish": {
      "provider": "github",
      "owner": "forsonny",
      "repo": "Rescayl",
      "releaseType": "draft"
    }
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "autoprefixer": "10.6.1",
    "cross-env": "10.1.0",
    "daisyui": "4.12.24",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "next": "16.3.8",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.6.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "3.4.19",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "tailwind-scrollbar": "3.1.0",
    "tailwindcss-animate": "1.0.7"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-toast": "1.2.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "18.0.5",
    "electron-is-dev": "2.0.0",
    "electron-log": "5.4.4",
    "electron-settings": "4.0.4",
    "electron-updater": "6.8.9",
    "exiftool-vendored": "38.3.0",
    "jotai": "3.0.1",
    "lucide-react": "1.52.0",
    "react-compare-slider": "4.0.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "2.1.9",
    "react-select": "5.10.2",
    "react-tooltip": "6.0.8",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "2.6.1",
    "theme-change": "3.0.4"
  },
  "volta": {
    "node": "24.21.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forsonny/Rescayl.git"
  }
}
